# Copy to backend/.env for local development (npm run dev loads it).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://app:app@localhost:5432/hubspot_sync
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# --- HubSpot public app (developers.hubspot.com) ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Must EXACTLY match a redirect URL registered on the HubSpot app. It points at the FRONTEND origin
# (Vite proxy locally, Vercel rewrite in production) so the session cookie is first-party.
HUBSPOT_REDIRECT_URI=http://localhost:5173/api/auth/hubspot/callback
# Must match the scopes configured on the HubSpot app.
HUBSPOT_SCOPES=oauth crm.objects.contacts.read crm.objects.contacts.write
# Public URL HubSpot calls for webhooks (needed for signature checks). Defaults to the redirect URI's origin.
# WEBHOOK_PUBLIC_URL=https://your-backend.example.com/api/webhooks/hubspot

FRONTEND_URL=http://localhost:5173
# openssl rand -hex 32
COOKIE_SECRET=change-me-to-at-least-32-random-characters
# openssl rand -base64 32   (32 bytes; losing it makes stored tokens unreadable => users must reconnect)
TOKEN_ENCRYPTION_KEY=

# --- Throughput knobs ---
SYNC_PAGE_SIZE=100
SYNC_CONCURRENCY=10
NOTES_CONCURRENCY=10
HUBSPOT_RATE_LIMIT_MAX=90
HUBSPOT_RATE_LIMIT_WINDOW_MS=10000
INCREMENTAL_INTERVAL_MIN=15
DB_POOL_MAX=20

# true = run workers inside the API process (simple/cheap). false = run `npm run start:worker` separately.
RUN_WORKERS_IN_API=true
AUTO_MIGRATE=true

# --- Demo without a HubSpot account: run `npm run mock:hubspot`, then uncomment ---
# HUBSPOT_API_BASE=http://127.0.0.1:4010
# HUBSPOT_AUTH_URL=http://127.0.0.1:4010/oauth/authorize
